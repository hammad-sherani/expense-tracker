# MongoDB Atlas connection string. The database name ("expense-tracker") goes before the "?".
# Prisma requires MongoDB to run as a replica set; Atlas clusters already are.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense-tracker?retryWrites=true&w=majority"

# IANA timezone used to decide what "today" and "this month" mean.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Karachi"

# Secret used to sign session cookies and hash OTP codes (32+ random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# SMTP settings for sending verification codes.
# Gmail example: host smtp.gmail.com, port 465, user = your Gmail, pass = a Google "App password".
# If SMTP_HOST is empty in development, the OTP is printed in the server console instead.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Spendwise <no-reply@example.com>"

# Used by `npm run create-admin` to create (or promote) the admin account.
ADMIN_USERNAME="admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
