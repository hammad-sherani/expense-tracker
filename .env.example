# MongoDB Atlas connection string. The database name ("expense-tracker") goes before the "?".
# Prisma requires MongoDB to run as a replica set; Atlas clusters already are.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense-tracker?retryWrites=true&w=majority"

# IANA timezone used to decide what "today" and "this month" mean.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Karachi"
